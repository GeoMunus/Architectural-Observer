{
  "name": "observer-ao",
  "version": "1.0.0",
  "description": "Observer AO — Architectural Observer, mobile Android app",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node build.mjs",
    "dev": "node build.mjs --dev",
    "watch": "node build.mjs --watch",
    "serve": "npx --yes http-server www -p 5173 -c-1",
    "sync": "npm run build && npx cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
